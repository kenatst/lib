    "couple.asymmetric.notice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You each received your own step today. Compare notes only if you both choose to."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez reçu chacun votre étape du jour. Ne comparez que si vous le décidez tous les deux."
          }
        }
      }
    },
    "couple.consent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We have both agreed to try this together — and either of us can stop anytime."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons tous les deux accepté d'essayer ensemble — et chacun peut arrêter à tout moment."
          }
        }
      }
    },
    "couple.demo.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today this works on one shared device: two spaces side by side. True two-device pairing — where your words stay on your own phone — is coming, and the app is built for it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aujourd'hui, cela fonctionne sur un appareil partagé : deux espaces côte à côte. L'association véritable entre deux téléphones — où vos mots restent sur le vôtre — est à venir, et l'app est déjà pensée pour cela."
          }
        }
      }
    },
    "couple.handoff.placeholder": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something to hand over, in your words…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelque chose à transmettre, avec vos mots…"
          }
        }
      }
    },
    "couple.invite.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For now, EMBER pairs two people on one shared device. Set the code down between you — each space opens only when its owner chooses."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour l'instant, EMBER associe deux personnes sur un appareil partagé. Posez le code entre vous — chaque espace ne s'ouvre que lorsque son propriétaire le décide."
          }
        }
      }
    },
    "couple.invite.header": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claim your spaces"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réclamez vos espaces"
          }
        }
      }
    },
    "couple.locked.other": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@'s space stays theirs. There is no way to open it from here."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'espace de %@ lui appartient. Il est impossible de l'ouvrir depuis ici."
          }
        }
      }
    },
    "couple.privacy.rule": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Private reflections stay private. No view, export or reminder will ever surface a partner's words without their explicit hand-off."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réflexions privées restent privées. Aucun écran, export ou rappel ne révèlera les mots d'un partenaire sans son geste explicite."
          }
        }
      }
    },
    "couple.role.first": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Partner One"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partenaire un"
          }
        }
      }
    },
    "couple.role.question": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who is holding the phone?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui tient le téléphone ?"
          }
        }
      }
    },
    "couple.role.second": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Partner Two"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partenaire deux"
          }
        }
      }
    },
    "couple.setup.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each of you receives a private space and daily steps of your own. What you write stays yours — sharing is always a deliberate hand-off, never automatic."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chacun reçoit un espace privé et ses propres étapes quotidiennes. Ce que vous écrivez vous appartient — partager est toujours un geste volontaire, jamais automatique."
          }
        }
      }
    },
    "couple.setup.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One journey, two people"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un parcours, deux personnes"
          }
        }
      }
    },
    "couple.shared.tonight": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Together tonight"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensemble ce soir"
          }
        }
      }
    },
    "couple.space.private": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@'s private space"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Espace privé — %@"
          }
        }
      }
    },
    "couple.switch.space": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch space"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer d'espace"
          }
        }
      }
    },
    "day.1.act": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tonight, sit for two unhurried minutes with the lights low and simply notice what you feel — nothing to fix, nothing to reach. If nothing comes, notice that too, kindly."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce soir, asseyez-vous deux minutes sans hâte, lumières basses, et remarquez simplement ce que vous ressentez — rien à corriger, rien à atteindre. S'il ne vient rien, remarquez-le aussi, avec douceur."
          }
        }
      }
    },
    "day.1.discover": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Desire often begins as attention. Before wanting anything more, notice what you already feel when the house goes quiet — warmth, numbness, curiosity, nothing. Whatever is there is information, not a verdict."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le désir commence souvent par l'attention. Avant d'en demander davantage, remarquez ce que vous ressentez déjà quand la maison se tait — chaleur, engourdissement, curiosité, rien. Tout ce qui est là est une information, pas un verdict."
          }
        }
      }
    },
    "day.1.reflect": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When today went quiet for a moment, where did your attention go?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand aujourd'hui s'est tu un instant, où votre attention est-elle allée ?"
          }
        }
      }
    },
    "day.1.return": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Did anything soften when you paid attention?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelque chose s'est-il adouci quand vous avez porté attention ?"
          }
        }
      }
    },
    "day.1.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Noticing"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remarquer"
          }
        }
      }
    },
    "day.10.act": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave one small warmth for someone — or for future-you: a note, a folded shirt, a favorite mug set out where morning will find it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déposez une petite chaleur pour quelqu'un — ou pour le vous de demain : un mot, une chemise pliée, une tasse préférée là où le matin la trouvera."
          }
        }
      }
    },
    "day.10.discover": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closeness compounds quietly. One small warmth today — a folded shirt, a favorite mug set out, a hand on a shoulder passing by — outweighs a grand gesture saved for someday."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La proximité compose en silence. Une petite chaleur aujourd'hui — une chemise pliée, une tasse préférée posée, une main sur une épaule au passage — pèse plus qu'un grand geste gardé pour un jour jamais venu."
          }
        }
      }
    },
    "day.10.reflect": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name one tiny warmth from this week nobody else would have noticed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nommez une petite chaleur de cette semaine que personne d'autre n'aurait remarquée."
          }
        }
      }
    },
    "day.10.return": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Did you manage to leave — or find — one small warmth?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avez-vous réussi à déposer — ou trouver — une petite chaleur ?"
          }
        }
      }
    },
    "day.10.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Small Warmths"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Petites chaleurs"
          }
        }
      }
    },
    "day.11.act": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel or shorten one obligation today. Feel the room it leaves behind. Do not fill it with productivity."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulez ou raccourcissez une obligation aujourd'hui. Sentez la place qu'elle laisse. Ne la remplissez pas de productivité."
          }
        }
      }
    },
    "day.11.discover": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Autonomy is not distance. It is the space where choice still lives — and choice is where wanting becomes possible. Removing expectation is itself an invitation; pressure is the opposite of appetite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'autonomie n'est pas la distance. C'est l'espace où le choix vit encore — et le choix rend le désir possible. Retirer l'attente est en soi une invitation ; la pression est l'opposé de l'appétit."
          }
        }
      }
    },
    "day.11.reflect": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where in your life do you currently have no room to choose? How does that sit in the body?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où, dans votre vie, n'avez-vous aucune place pour choisir ? Comment ça se loge dans le corps ?"
          }
        }
      }
    },
    "day.11.return": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Did saying no to something small leave any room behind?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Refuser une petite chose a-t-il laissé de la place derrière ?"
          }
        }
      }
    },
    "day.11.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Elbow Room"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De la place pour respirer"
          }
        }
      }
    },
    "day.12.act": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose one familiar object and give it five minutes of slow attention. Let it become new without changing at all."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un objet familier et donnez-lui cinq minutes d'attention lente. Laissez-le devenir neuf sans changer du tout."
          }
        }
      }
    },
    "day.12.discover": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Familiarity hides things in plain sight. The face you know by heart still changes daily. Looking again — slowly, as if for the first time — can make the known feel newly made."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La familiarité cache des choses sous nos yeux. Le visage que vous connaissez par cœur change chaque jour. Regarder encore — lentement, comme pour la première fois — peut rendre le connu tout neuf."
          }
        }
      }
    },
    "day.12.reflect": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look at something familiar as if for the first time. What had you never noticed?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regardez quelque chose de familier comme pour la première fois. Qu'avez-vous jamais remarqué ?"
          }
        }
      }
    },
    "day.12.return": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Did the familiar look even slightly new?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le familier a-t-il paru même légèrement neuf ?"
          }
        }
      }
    },
    "day.12.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looking Again"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regarder encore"
          }
        }
      }
    },
    "day.13.act": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let someone catch you mid-delight today — humming, dancing badly, absorbed in something trivial. Do not apologize for it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez quelqu'un vous surprendre en plein ravissement — en fredonnant, en dansant mal, absorbé·e par un rien. Ne vous excusez pas."
          }
        }
      }
    },
    "day.13.discover": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Being wanted begins with being seen. Let yourself be witnessed in something small and true today — mid-hum, mid-absorption, unguarded — and notice that you survived it. That is the whole lesson."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se sentir désiré commence par être vu. Laissez-vous surprendre dans quelque chose de petit et vrai aujourd'hui — en train de fredonner, absorbé·e, sans garde — et remarquez que vous y avez survécu. C'est toute la leçon."
          }
        }
      }
    },
    "day.13.reflect": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recall a moment you felt truly seen. Who witnessed you, and what exactly did they see?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Souvenez-vous d'un moment où vous vous êtes senti·e vraiment vu·e. Qui vous regardait, et voyait quoi exactement ?"
          }
        }
      }
    },
    "day.13.return": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Did being witnessed feel risky, warm, or both?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Surprendre votre ravissement : risqué, chaleureux, ou les deux ?"
          }
        }
      }
    },
    "day.13.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Witnessed"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vu·e"
          }
        }
      }
    },
    "day.14.act": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give three no-agenda touches today: a hand on a shoulder, a brush of arms, fingers through hair — yours or theirs. Want nothing back."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Offrez trois contacts sans programme aujourd'hui : une main sur une épaule, un bras qui frôle, des doigts dans des cheveux — les vôtres ou les leurs. Sans rien attendre en retour."
          }
        }
      }
    },
    "day.14.discover": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Affection without agenda rebuilds trust in touch itself. A hand that wants nothing teaches the skin a new language. Give three no-agenda touches today and receive at least one without returning it like a debt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'affection sans programme reconstruit la confiance dans le contact. Une main qui ne veut rien apprend une langue nouvelle à la peau. Offrez trois contacts sans attente aujourd'hui et recevez-en un sans le rendre comme une dette."
          }
        }
      }
    },
    "day.14.reflect": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Think of affection that asked nothing of you. How did it change the rest of that day?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pensez à une affection qui ne demandait rien. Comment cela a-t-il changé le reste de ce jour-là ?"
          }
        }
      }
    },
    "day.14.return": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Did touch without agenda land differently?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contact sans programme a-t-il atterri autrement ?"
          }
        }
      }
    },
    "day.14.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Long Echo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le long écho"
          }
        }
      }
    },
    "day.15.act": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change one detail of your usual tonight: a different route home, cup, playlist, or lamp. Notice how attention follows the difference."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changez un détail de votre habitude ce soir : un trajet, une tasse, une playlist, une lampe. Remarquez comme l'attention suit la différence."
          }
        }
      }
    },
    "day.15.discover": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Novelty right-sized is a doorway, not a leap. One new lamp, one new playlist, one hour rearranged — attention follows difference like a cat follows movement. Grand gestures startle; small ones beckon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La nouveauté à la bonne dose est une porte, pas un saut. Une lampe nouvelle, une playlist différente, une heure déplacée — l'attention suit la différence comme un chat suit le mouvement. Les grands gestes font sursauter ; les petits invitent."
          }
        }
      }
    },
    "day.15.reflect": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which small departure from routine could you make tomorrow without anyone's permission?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel petit écart de routine pourriez-vous prendre demain sans la permission de personne ?"
          }
        }
      }
    },
    "day.15.return": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Did one changed detail change your attention?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un détail changé a-t-il changé votre attention ?"
          }
        }
      }
    },
    "day.15.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right-Sized Newness"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nouveauté à la bonne dose"
          }
        }
      }
    },
    "day.16.act": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Absorb yourself in something small until you forget to perform. If someone notices, let them see the absorption, not a show."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Absorbez-vous dans quelque chose de petit jusqu'à oublier de jouer. Si quelqu'un remarque, laissez voir l'absorption, pas un spectacle."
          }
        }
      }
    },
    "day.16.discover": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is a specific charge in being caught delighting. Not performing pleasure — being absorbed by it. Witnessed joy is disarming precisely because it cannot be faked."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il y a une tension particulière à être surpris·e en plein plaisir. Non pas en train de jouer le plaisir — absorbé·e par lui. La joie surprise désarme parce qu'elle ne peut pas être simulée."
          }
        }
      }
    },
    "day.16.reflect": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Has anyone ever caught you mid-delight? What were they allowed to see?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On vous a déjà surpris·e en plein ravissement ? Qu'aviez-vous permis de voir ?"
          }
        }
      }
    },
    "day.16.return": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Did rest arrive? Did anything wake up after it?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le repos est-il venu ? Quelque chose s'est-il réveillé après ?"
          }
        }
      }
    },
    "day.16.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Being Seen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Être vu·e"
          }
        }
      }
    },
    "day.17.act": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recreate one ritual from early days — the same song, the same seat, the same candle. Let memory begin the charging; add nothing forced."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recréez un rituel des premiers jours — la même chanson, la même place, la même bougie. Laissez la mémoire commencer la recharge ; n'ajoutez rien de forcé."
          }
        }
      }
    },
    "day.17.discover": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rituals hold tension beautifully. The same candle, the same song, the same seat on the sofa — repetition is not the enemy of desire; it is its memory. What was charged once can be charged again by signal alone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rituels retiennent admirablement la tension. La même bougie, la même chanson, la même place sur le canapé — la répétition n'est pas l'ennemie du désir ; elle en est la mémoire. Ce qui a été chargé une fois peut l'être à nouveau par le seul signal."
          }
        }
      }
    },
    "day.17.reflect": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What repeated place or gesture could become charged again if you let it?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel lieu ou quel geste répété pourrait se recharger si vous le laissiez faire ?"
          }
        }
      }
    },
    "day.17.return": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Did the open question keep you company?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La question ouverte vous a-t-elle tenu compagnie ?"
          }
        }
      }
    },
    "day.17.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritual and Charge"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rituel et tension"
          }
        }
      }
    },
    "day.18.act": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to bed thirty minutes earlier than justified. Desire negotiates with exhaustion; win that deal once tonight."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couchez-vous trente minutes plus tôt que ce qui serait justifié. Le désir négocie avec l'épuisement ; gagnez ce marché une fois ce soir."
          }
        }
      }
    },
    "day.18.discover": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rest is part of desire. Tired bodies defend themselves with numbness — it is protection, not brokenness. Go earlier, do less, and treat the numbness not as a fault to fix but as a gatekeeper to negotiate with gently."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le repos fait partie du désir. Les corps fatigués se défendent par l'engourdissement — c'est une protection, pas une panne. Couchez-vous plus tôt, faites moins, et traitez l'engourdissement non comme un défaut mais comme un gardien avec qui négocier doucement."
          }
        }
      }
    },
    "day.18.reflect": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What does tiredness talk you out of wanting? Write its exact words."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contre quelles envies la fatigue vous parle-t-elle ? Écrivez ses mots exacts."
          }
        }
      }
    },
    "day.18.return": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can you name which season you're in yet?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrivez-vous à nommer votre saison ?"
          }
        }
      }
    },
    "day.18.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permission to Rest"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La permission de me reposer"
          }
        }
      }
    },
    "day.19.act": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow one genuine question about yourself today. Ask it silently, then let it stay open while you walk, wash, wait."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez aujourd'hui une vraie question sur vous-même. Posez-la en silence, puis laissez-la ouverte pendant que vous marchez, vous lavez, vous attendez."
          }
        }
      }
    },
    "day.19.discover": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Curiosity about your own responses is the most durable kind. You are allowed to be a mystery to yourself. The question you cannot answer yet is worth keeping company with — answers rush; curiosity strolls."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La curiosité pour vos propres réactions est la plus durable. Vous avez le droit d'être un mystère pour vous-même. La question à laquelle vous ne répondez pas encore mérite qu'on lui tienne compagnie — les réponses courent ; la curiosité se promène."
          }
        }
      }
    },
    "day.19.reflect": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask yourself a question you don't know the answer to. Keep it company for a minute."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez-vous une question dont vous ignorez la réponse. Tenez-lui compagnie une minute."
          }
        }
      }
    },
    "day.19.return": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Did the old song hold any charge?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ancienne chanson a-t-elle encore résonné en vous ?"
          }
        }
      }
    },
    "day.19.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Question Kept Open"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une question laissée ouverte"
          }
        }
      }
    },
    "day.2.act": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a slower shower or bath than usual. Treat your own skin as familiar terrain worth revisiting — no goal beyond paying attention differently."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenez une douche ou un bain plus lent que d'habitude. Traitez votre peau comme un terrain familier qui mérite une autre visite — aucun but au-delà d'une attention différente."
          }
        }
      }
    },
    "day.2.discover": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The body keeps its own schedule, and it is not a timetable of obligation. Ease — not effort — is usually the door desire walks through. A body that feels watched performs; a body that feels safe can want."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le corps suit son propre calendrier, et ce n'est pas un emploi du temps d'obligations. L'aise — pas l'effort — est généralement la porte par laquelle le désir entre. Un corps qui se sent observé joue la comédie ; un corps en sécurité peut désirer."
          }
        }
      }
    },
    "day.2.reflect": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where in your body do you notice ease — even a little? What sits near it?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où, dans votre corps, remarquez-vous de l'aise — même un peu ? Qu'y a-t-il tout près ?"
          }
        }
      }
    },
    "day.2.return": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Did your body tell you anything today?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre corps vous a-t-il dit quelque chose aujourd'hui ?"
          }
        }
      }
    },
    "day.2.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Body's Schedule"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le calendrier du corps"
          }
        }
      }
    },
    "day.20.act": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say aloud — to them, or just to the room — whether this week feels like distance or closeness. No verdict required."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites à voix haute — à cette personne, ou juste à la pièce — si cette semaine ressemble à la distance ou à la proximité. Aucun verdict requis."
          }
        }
      }
    },
    "day.20.discover": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Distance and closeness take turns in every long story. Neither is failure. Naming which season you are in dissolves half the confusion — and half the loneliness that comes from misreading weather as character."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La distance et la proximité alternent dans toute longue histoire. Ni l'une ni l'autre n'est un échec. Nommer votre saison dissout la moitié de la confusion — et la moitié de la solitude née de confondre la météo avec le caractère."
          }
        }
      }
    },
    "day.20.reflect": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you in a season of distance or of closeness right now? Name it without judging it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans quelle saison êtes-vous : distance ou proximité ? Nommez-la sans juger."
          }
        }
      }
    },
    "day.20.return": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Is tomorrow's small pleasure already glowing a little?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le petit plaisir de demain luit-il déjà un peu ?"
          }
        }
      }
    },
    "day.20.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch Without Agenda"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contact sans programme"
          }
        }
      }
    },
    "day.21.act": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the one practice from these weeks you'll keep. Do it once more today — deliberately, as a keeper, not an experiment."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la pratique de ces semaines que vous garderez. Refaites-la une fois aujourd'hui — délibérément, non plus en expérience mais en choix."
          }
        }
      }
    },
    "day.21.discover": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After three weeks, nothing needs to be finished. Something, though, may have stirred — a longer look, an easier laugh, a night you turned toward instead of away. The work now is choosing what to keep."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après trois semaines, rien n'a besoin d'être terminé. Mais quelque chose a peut-être remué — un regard plus long, un rire plus facile, une nuit où vous vous êtes tourné·e vers plutôt que contre. Le travail, maintenant, est de choisir quoi garder."
          }
        }
      }
    },
    "day.21.reflect": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After these weeks: what do you want to keep? Choose one thing and claim it in writing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après ces semaines : que voulez-vous garder ? Choisissez une chose et revendiquez-la par écrit."
          }
        }
      }
    },
    "day.21.return": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which keeper will you carry beyond these three weeks?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel gardien emporterez-vous au-delà de ces trois semaines ?"
          }
        }
      }
    },
    "day.21.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Keeper"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que l'on garde"
          }
        }
      }
    },
    "day.3.act": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plant one seed of anticipation: mention lightly that you have something small in mind for later this week. Let the hint do the working."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plantez une graine d'anticipation : évoquez légèrement que vous avez quelque chose de petit en tête pour cette semaine. Laissez l'indice travailler."
          }
        }
      }
    },
    "day.3.discover": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anticipation is a sense in its own right. A hint today — a look held a moment longer, a message that promises nothing and implies everything — can do the quiet work of an entire evening."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'anticipation est un sens à part entière. Un indice aujourd'hui — un regard retenu une seconde de plus, un message qui ne promet rien et suggère tout — accomplit tranquillement le travail d'une soirée entière."
          }
        }
      }
    },
    "day.3.reflect": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If desire arrived tonight like weather, what would the forecast honestly say?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si le désir arrivait ce soir comme une météo, que dirait-elle honnêtement ?"
          }
        }
      }
    },
    "day.3.return": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Is there anything you're quietly looking forward to now?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Y a-t-il désormais quelque chose que vous attendez en silence ?"
          }
        }
      }
    },
    "day.3.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Sense of Before"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sens de l'avant"
          }
        }
      }
    },
    "day.4.act": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once today, follow your attention on purpose — watch light move across a wall, listen to one full song, look slowly at a face in a photograph."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois aujourd'hui, suivez votre attention exprès — regardez la lumière traverser un mur, écoutez une chanson entière, contemplez un visage sur une photo."
          }
        }
      }
    },
    "day.4.discover": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attention is not a given; it is a practice. What you look at softly tends to warm. What you audit coldly tends to hide. Today, practice looking at one thing — a person, a plant, your own hands — without trying to fix anything about it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'attention n'est pas acquise ; c'est une pratique. Ce que vous regardez doucement tend à se réchauffer. Ce que vous auditez froidement tend à se cacher. Aujourd'hui, regardez une chose — une personne, une plante, vos mains — sans rien vouloir corriger."
          }
        }
      }
    },
    "day.4.reflect": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What did you look at longer than you needed today? What kept you there?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'avez-vous regardé plus longtemps que nécessaire ? Qu'est-ce qui vous y retenait ?"
          }
        }
      }
    },
    "day.4.return": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Did you notice where your attention wanted to go?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avez-vous remarqué où votre attention voulait aller ?"
          }
        }
      }
    },
    "day.4.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Soft Attention"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'attention douce"
          }
        }
      }
    },
    "day.5.act": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear one hour this evening of every expectation — including your own. Leave the hour shapeless and see what wants to grow in it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dégager une heure ce soir de toute attente — y compris la vôtre. Laissez l'heure sans forme et voyez ce qui veut y pousser."
          }
        }
      }
    },
    "day.5.discover": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanting needs room to arrive into. An hour with no agenda is not an empty hour; it is an open door. Desire rarely knocks on a door that is already full."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le désir a besoin de place pour arriver. Une heure sans programme n'est pas une heure vide ; c'est une porte ouverte. Le désir frappe rarement à une porte déjà pleine."
          }
        }
      }
    },
    "day.5.reflect": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What are you looking forward to that hasn't happened yet? Stay with it one breath."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À quoi attendez-vous qui ne s'est pas encore produit ? Restez-y un souffle."
          }
        }
      }
    },
    "day.5.return": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What was it like to owe the hour nothing?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce que ça faisait de ne rien devoir à l'heure dégagée ?"
          }
        }
      }
    },
    "day.5.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Room to Arrive"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La place pour arriver"
          }
        }
      }
    },
    "day.6.act": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before sleep, name three conditions that would make you feel safe enough to want. Just name them; act on none of them yet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant de dormir, nommez trois conditions qui vous feraient sentir assez en sécurité pour désirer. Nommez-les seulement ; n'y agissez pas encore."
          }
        }
      }
    },
    "day.6.discover": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Desire listens for safety before it speaks. It asks: can I want something here without owing anything? Can I be clumsy here? The conditions matter more than the mood."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le désir écoute la sécurité avant de parler. Il demande : puis-je vouloir quelque chose ici sans rien devoir ? Puis-je être maladroit ici ? Les conditions comptent plus que l'humeur."
          }
        }
      }
    },
    "day.6.reflect": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What would make the next hour feel safe enough to want something inside it?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce qui rendrait l'heure qui vient assez sûre pour y vouloir quelque chose ?"
          }
        }
      }
    },
    "day.6.return": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Did it feel safer to want something today?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous a-t-il semblé plus sûr de vouloir quelque chose aujourd'hui ?"
          }
        }
      }
    },
    "day.6.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Conditions"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les conditions"
          }
        }
      }
    },
    "day.7.act": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write one honest sentence about what you miss — precise, blame-free — and keep it somewhere only you will find it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrivez une phrase honnête sur ce qui vous manque — précise, sans reproche — et gardez-la où vous seule·e la trouverez."
          }
        }
      }
    },
    "day.7.discover": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Words draw maps. When you can say what you miss — precisely, without blame — the territory between you and what you want becomes navigable. Vague longing stays lost; named longing finds roads."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mots dessinent des cartes. Quand vous pouvez dire ce qui vous manque — précisément, sans reproche — le territoire entre vous et ce que vous voulez devient praticable. L'envie vague reste perdue ; l'envie nommée trouve des routes."
          }
        }
      }
    },
    "day.7.reflect": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish this sentence without editing: \"What I miss is…\""
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminez cette phrase sans corriger : « Ce qui me manque, c'est… »"
          }
        }
      }
    },
    "day.7.return": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Was the honest sentence hard to write? That's information too."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La phrase honnête était-elle difficile à écrire ? C'est une information aussi."
          }
        }
      }
    },
    "day.7.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drawing the Map"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessiner la carte"
          }
        }
      }
    },
    "day.8.act": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say the sentence from Day 7 aloud when alone. Hear your own voice claim it. Notice what flinches and what steadies."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites la phrase du jour 7 à voix haute, seul·e. Entendez votre propre voix la revendiquer. Remarquez ce qui se cabre et ce qui s'apaise."
          }
        }
      }
    },
    "day.8.discover": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Longing has a shape if you let it speak. \"I miss being looked at\" and \"I miss being taken\" are different countries. Naming which country you live in changes everything you might pack."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'envie a une forme si vous la laissez parler. « On me regarde moins » et « je me sens désirable » sont deux pays différents. Savoir dans quel pays vous vivez change tout ce que vous pourriez emporter."
          }
        }
      }
    },
    "day.8.reflect": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete the sentence honestly: \"I miss being…\" Which word came first?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Complétez honnêtement : « Il me manque de… » Quel mot est arrivé premier ?"
          }
        }
      }
    },
    "day.8.return": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Did saying the sentence aloud change it?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dire la phrase à voix haute l'a-t-elle changée ?"
          }
        }
      }
    },
    "day.8.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What I Miss"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui me manque"
          }
        }
      }
    },
    "day.9.act": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do one deliberately playful thing: an absurd comment delivered deadpan, a silly walk past a mirror, a game you allow yourself to win."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites une chose résolument ludique : un commentaire absurde au visage fermé, une démarche ridicule devant le miroir, une partie que vous vous autorisez à gagner."
          }
        }
      }
    },
    "day.9.discover": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play is seriousness with its shoes off. It is not childish — it is the oldest form of intimacy: two creatures signaling safety through laughter. Curiosity counts even when it ends only in giggles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeu, c'est le sérieux qui a quitté ses chaussures. Ce n'est pas puéril — c'est la plus ancienne forme d'intimité : deux créatures qui annoncent la sécurité par le rire. La curiosité compte même quand elle finit en fou rire."
          }
        }
      }
    },
    "day.9.reflect": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When did something last make you smile at yourself, alone?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand, pour la dernière fois, quelque chose vous a fait sourire à vous-même, seul·e ?"
          }
        }
      }
    },
    "day.9.return": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Did anything make you smile at yourself today?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelque chose vous a-t-il fait sourire à vous-même aujourd'hui ?"
          }
        }
      }
    },
    "day.9.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seriousness, Off Duty"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sérieux en congé"
          }
        }
      }
    },
