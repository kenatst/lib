          }
        }
      }
    },
    "q.duration.months": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A few months"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelques mois"
          }
        }
      }
    },
    "q.duration.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How long has it felt this way?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depuis combien de temps en êtes-vous là ?"
          }
        }
      }
    },
    "q.duration.unsure": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard to say — it crept up"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Difficile à dire — c'est venu en douceur"
          }
        }
      }
    },
    "q.duration.weeks": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A few weeks"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelques semaines"
          }
        }
      }
    },
    "q.my.pressure.curiosity": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Curiosity"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La curiosité"
          }
        }
      }
    },
    "q.my.pressure.guilt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bit of guilt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une certaine culpabilité"
          }
        }
      }
    },
    "q.my.pressure.hope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet hope"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un espoir discret"
          }
        }
      }
    },
    "q.my.pressure.pressure": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressure"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La pression"
          }
        }
      }
    },
    "q.my.pressure.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanting more can bring different feelings. Which is loudest?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vouloir davantage réveille différentes sensations. Laquelle parle le plus fort ?"
          }
        }
      }
    },
    "q.my.selfconnection.distant": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's been a long time"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela fait longtemps"
          }
        }
      }
    },
    "q.my.selfconnection.passing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sometimes, in passing"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parfois, fugitivement"
          }
        }
      }
    },
    "q.my.selfconnection.recent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recently"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Récemment"
          }
        }
      }
    },
    "q.my.selfconnection.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When did you last feel at ease in your own body?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous êtes-vous senti·e, pour la dernière fois, bien dans votre corps ?"
          }
        }
