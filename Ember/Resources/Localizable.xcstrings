            "state": "translated",
            "value": "If anything stirred, keep a line for yourself."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si quelque chose a remué, gardez-en une ligne pour vous."
          }
        }
      }
    },
    "session.reflect.save": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep privately"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder pour moi"
          }
        }
      }
    },
    "session.reflect.saved": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kept on this device only."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservé sur cet appareil uniquement."
          }
        }
      }
    },
    "session.step.act.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Experiment"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Expérimenter"
          }
        }
      }
    },
    "session.step.discover.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discover"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Découvrir"
          }
        }
      }
    },
    "session.step.reflect.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reflect"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se poser la question"
          }
        }
      }
    },
    "settings.about.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "EMBER is a private space for adults reconnecting with desire and closeness. It offers ideas and experiments — never diagnosis or therapy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "EMBER est un espace privé pour les adultes qui renouent avec le désir et la proximité. Il propose des idées et des expériences — jamais un diagnostic ni une thérapie."
          }
        }
      }
    },
    "settings.about.header": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About EMBER"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À propos d'EMBER"
          }
        }
      }
    },
    "settings.data.delete": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete everything EMBER knows"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout supprimer"
          }
        }
      }
    },
    "settings.data.delete.confirm.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your answers, reflections and journey progress will be erased from this device immediately. This cannot be undone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos réponses, vos réflexions et votre progression seront effacées de cet appareil immédiatement. Cette action est irréversible."
          }
        }
      }
    },
    "settings.data.delete.confirm.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete all EMBER data?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer toutes les données EMBER ?"
          }
        }
      }
    },
    "settings.data.delete.failed.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data is untouched — nothing was erased. EMBER will not pretend otherwise. Try again in a moment; if this keeps happening, restart the app so it can reach your data safely."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données sont intactes — rien n'a été effacé. EMBER ne prétendra pas le contraire. Réessayez dans un instant ; si cela persiste, relancez l'app pour qu'elle puisse accéder à vos données en sécurité."
          }
        }
      }
    },
    "settings.data.delete.failed.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletion didn't complete"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression n'a pas abouti"
          }
        }
      }
    },
    "settings.data.header": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données"
          }
        }
      }
    },
    "settings.journey.header": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your journey"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre parcours"
          }
        }
      }
    },
    "settings.journey.restart": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin a different journey"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencer un autre parcours"
          }
        }
      }
    },
    "settings.journey.restart.confirm.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your current journey progress and reflections will be erased so you can begin fresh."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre parcours en cours et vos réflexions seront effacés pour repartir à neuf."
          }
        }
      }
    },
    "settings.language.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "EMBER speaks English and French."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "EMBER parle anglais et français."
          }
        }
      }
    },
    "settings.privacy.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything you write stays on this device, protected at rest.\nNothing is uploaded. There are no accounts, no analytics, no trackers.\nWhat you delete below is deleted for good."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce que vous écrivez reste sur cet appareil, protégé au repos.\nRien n'est envoyé. Aucun compte, aucun traqueur, aucune publicité.\nCe que vous supprimez ci-dessous l'est définitivement."
          }
        }
      }
    },
    "settings.privacy.header": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy, plainly"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La confidentialité, simplement"
          }
        }
      }
    },
    "settings.reminder.header": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A gentle reminder"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rappel en douceur"
          }
        }
      }
    },
    "settings.reminder.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only on this device. A quiet nudge — no content, no streaks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur cet appareil uniquement. Une pensée discrète — sans contenu, sans séries."
          }
        }
      }
    },
    "settings.reminder.time": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À"
          }
        }
      }
    },
    "settings.reminder.toggle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remind me once a day"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Me rappeler une fois par jour"
          }
        }
      }
    },
    "settings.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglages"
          }
        }
      }
    },
    "settings.version": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@"
          }
        }
      }
    },
    "theme.act.anticipation.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plant one seed of anticipation: mention, lightly, that you have something small in mind for later this week."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plantez une graine d'anticipation : évoquez légèrement que vous avez quelque chose en tête pour plus tard cette semaine."
          }
        }
      }
    },
    "theme.act.anticipation.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper-plan tomorrow's smallest pleasure — the coffee, the light, ten quiet minutes. Then protect it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ourdissez en sourdine le plus petit plaisir de demain — le café, la lumière, dix minutes calmes. Puis protégez-le."
          }
        }
      }
    },
    "theme.act.anticipation.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send a single line to someone safe about looking forward to something real. Nothing more needed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez une seule ligne, à quelqu'un de sûr, au sujet d'une attente bien réelle. Rien de plus."
          }
        }
      }
    },
    "theme.act.attention.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once today, follow your attention on purpose — watch light move, listen to one full song, look slowly at one face."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois aujourd'hui, suivez votre attention exprès — regardez la lumière bouger, écoutez une chanson entière, contemplez lentement un visage."
          }
        }
      }
    },
    "theme.act.attention.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick one routine moment — the kettle, the key in the lock — and give it your full attention, as if rehearsing it for memory."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un moment routinier — la bouilloire, la clé dans la serrure — et portez-lui toute votre attention, comme pour le graver."
          }
        }
      }
    },
    "theme.act.attention.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit for two unhurried minutes with the lights low and simply notice what you feel. Nothing to fix."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Asseyez-vous deux minutes sans presser, lumière basse, et remarquez simplement ce que vous ressentez. Rien à réparer."
          }
        }
      }
    },
    "theme.act.autonomy.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel or shorten one obligation today. Feel the room it leaves behind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulez ou raccourcissez une obligation aujourd'hui. Sentez la place qu'elle laisse derrière elle."
          }
        }
      }
    },
    "theme.act.autonomy.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tonight, remove all expectations from one hour. Whatever happens — or doesn't — is the point."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce soir, retirez toute attente d'une heure entière. Ce qui arrive — ou non — est le propos."
          }
        }
      }
    },
    "theme.act.autonomy.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say one clear no today — small, kind, complete. Notice what space survives it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites un non clair aujourd'hui — petit, aimable, définitif. Remarquez l'espace qui lui survit."
          }
        }
      }
    },
    "theme.act.body.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a slower shower or bath than usual. Treat your own skin as terrain worth revisiting."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenez une douche ou un bain plus lent que d'habitude. Considérez votre peau comme un territoire qui mérite qu'on y retourne."
          }
        }
      }
    },
    "theme.act.body.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stretch for three minutes tonight — not to improve anything, just to be informed by your own body."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Étirez-vous trois minutes ce soir — non pour progresser, mais pour laisser votre corps vous renseigner."
          }
        }
      }
    },
    "theme.act.body.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wear or touch one fabric today purely for how it feels. Let comfort be the whole point."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Portez ou touchez un tissu aujourd'hui rien que pour sa sensation. Que le confort soit tout le propos."
          }
        }
      }
    },
    "theme.act.closeness.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave one small warmth for someone — or for future-you: a note, a folded shirt, a favorite mug set out."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez une petite chaleur à quelqu'un — ou au vous futur : un mot, une chemise pliée, la tasse préférée posée."
          }
        }
      }
    },
    "theme.act.closeness.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give three no-agenda touches today: a hand on a shoulder, a brush of arms — yours or theirs."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Offrez trois contacts sans attente aujourd'hui : une main sur une épaule, un bras effleuré — le vôtre ou le leur."
          }
        }
      }
    },
    "theme.act.closeness.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recall one ritual from early days — same song, same seat. Recreate it tonight; let memory charge it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retrouvez un rituel des premiers jours — même chanson, même siège. Recréez-le ce soir ; laissez la mémoire le charger."
          }
        }
      }
    },
    "theme.act.communication.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write one honest sentence about what you miss — and keep it where only you will find it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrivez une phrase honnête sur ce qui vous manque — et gardez-la où vous seul·e la trouverez."
          }
        }
      }
    },
    "theme.act.communication.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say aloud — to them, or just to yourself — one true thing about this week. No editing for effect."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites à voix haute — à eux, ou à vous seul·e — une chose vraie à propos de cette semaine. Sans mise en scène."
          }
        }
      }
    },
    "theme.act.communication.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask someone (or answer, in writing) one question you've never dared: what do you miss most?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez à quelqu'un (ou répondez par écrit) une question jamais osée : qu'est-ce qui te manque le plus ?"
          }
        }
      }
    },
    "theme.act.novelty.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change one detail of your usual: a different route, cup, playlist, or lamp. Notice how attention follows."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changez un détail de votre habitude : un autre trajet, tasse, playlist ou lampe. Remarquez comme l'attention suit."
          }
        }
      }
    },
    "theme.act.novelty.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose one familiar object and give it five slow minutes. Let it become new."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un objet familier et offrez-lui cinq minutes lentes. Laissez-le redevient neuf."
          }
        }
      }
    },
    "theme.act.novelty.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do one small thing differently tonight — brush hair in a new order, sit elsewhere, reverse the ritual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites une petite chose différemment ce soir — coiffez-vous dans un autre ordre, asseyez-vous ailleurs, inversez le rituel."
          }
        }
      }
    },
    "theme.act.play.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do one deliberately playful thing today: an absurd comment, a silly walk past a mirror, a game you win alone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites une chose résolument joueuse aujourd'hui : un commentaire absurde, une démarche ridicule devant le miroir, une partie gagnée seul·e."
          }
        }
      }
    },
    "theme.act.play.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let someone catch you mid-delight today — humming, dancing, absorbed. Don't apologize for it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez quelqu'un vous surprendre en plein ravissement — fredonnant, dansant, absorbé·e. Ne vous excusez pas."
          }
        }
      }
    },
    "theme.act.play.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make one ordinary task absurdly enjoyable tonight — music too loud, race against the timer, dessert first."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendez une tâche ordinaire absurment agréable ce soir — musique trop forte, course contre le minuteur, dessert d'abord."
          }
        }
      }
    },
    "theme.discover.anticipation.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anticipation is a sense in its own right. A hint today — a look held a moment longer, a message that promises nothing and implies everything — can do the quiet work of an entire evening."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'anticipation est un sens à part entière. Un indice aujourd'hui — un regard retenu une seconde de plus, un message qui ne promet rien et suggère tout — accomplit tranquillement le travail d'une soirée entière."
          }
        }
      }
    },
    "theme.discover.anticipation.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rituals hold tension beautifully. The same candle, the same song, the same seat on the sofa — repetition is not the enemy of desire; it is its memory. What was charged once can be charged again by signal alone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rituels tiennent bien la tension. La même bougie, la même chanson, la même place sur le canapé — la répétition n'est pas l'ennemie du désir ; elle en est la mémoire. Ce qui a été chargé une fois peut l'être de nouveau par le seul signal."
          }
        }
      }
    },
    "theme.discover.anticipation.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looking forward and arriving are different pleasures. Give the first one room today and the second one softens. Carry one small plan into tomorrow like a lit match cupped from wind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendre et arriver sont deux plaisirs différents. Donnez aujourd'hui de la place au premier et le second s'adoucit. Portez un petit projet vers demain comme une allumette protégée du vent."
          }
        }
      }
    },
    "theme.discover.attention.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Desire often begins as attention. Before wanting anything more, notice what you already feel when the house goes quiet — warmth, numbness, curiosity, nothing. Whatever is there is information, not a verdict."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le désir commence souvent par l'attention. Avant d'en demander davantage, remarquez ce que vous ressentez déjà quand la maison se tait — chaleur, engourdissement, curiosité, rien. Tout ce qui est là est une information, pas un verdict."
          }
        }
      }
    },
    "theme.discover.attention.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attention is not a given; it is a practice. What you look at softly tends to warm. What you audit coldly tends to hide."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'attention n'est pas acquise ; c'est une pratique. Ce que vous regardez doucement tend à se réchauffer. Ce que vous auditez froidement tend à se cacher."
          }
        }
      }
    },
    "theme.discover.attention.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Being wanted begins with being seen. Let yourself be witnessed in something small and true today — mid-hum, mid-absorption, unguarded — and notice that you survived it. That is the whole lesson."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se sentir désiré commence par être vu. Laissez-vous surprendre dans quelque chose de petit et vrai aujourd'hui — en train de fredonner, absorbé·e, sans garde — et remarquez que vous y avez survécu. C'est toute la leçon."
          }
        }
      }
    },
    "theme.discover.autonomy.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanting needs room to arrive into. An hour with no agenda is not an empty hour; it is an open door. Desire rarely knocks on a door that is already full."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le désir a besoin de place pour arriver. Une heure sans programme n'est pas une heure vide ; c'est une porte ouverte. Le désir frappe rarement à une porte déjà pleine."
          }
        }
      }
    },
    "theme.discover.autonomy.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Autonomy is not distance. It is the space where choice still lives — and choice is where wanting becomes possible. Removing expectation is itself an invitation; pressure is the opposite of appetite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'autonomie n'est pas la distance. C'est l'espace où le choix vit encore — et le choix rend le désir possible. Retirer l'attente est en soi une invitation ; la pression est l'opposée de l'appétit."
          }
        }
      }
    },
    "theme.discover.autonomy.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No is a complete sentence, and it protects yes. Each time you decline what you do not want, the things you choose gain weight. Today, protect one small yes with a clear no."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non est une phrase complète, et elle protège oui. Chaque fois que vous refusez ce que vous ne voulez pas, ce que vous choisissez prend du poids. Aujourd'hui, protégez un petit oui par un non clair."
          }
        }
      }
    },
    "theme.discover.body.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The body keeps its own schedule, and it is not a timetable of obligation. Ease — not effort — is usually the door desire walks through. A body that feels watched performs; a body that feels safe can want."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le corps suit son propre calendrier, et ce n'est pas un emploi du temps d'obligations. L'aise — pas l'effort — est généralement la porte par laquelle le désir entre. Un corps qui se sent observé joue la comédie ; un corps en sécurité peut désirer."
          }
        }
      }
    },
    "theme.discover.body.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rest is part of desire. Tired bodies defend themselves with numbness — it is protection, not brokenness. Treat the numbness not as a fault to fix but as a gatekeeper to negotiate with gently."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le repos fait partie du désir. Les corps fatigués se défendent par l'engourdissement — c'est une protection, pas une casse. Traitez cet engourdissement non comme un défaut à réparer mais comme un gardien avec qui négocier doucement."
          }
        }
      }
    },
    "theme.discover.body.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Curiosity about your own responses is the most durable kind. You are allowed to be a mystery to yourself. The question you cannot answer yet is worth keeping company with — answers rush; curiosity strolls."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La curiosité envers vos propres réactions est la plus durable. Vous avez le droit d'être un mystère pour vous-même. La question à laquelle vous ne pouvez pas encore répondre mérite qu'on lui tienne compagnie — les réponses courent ; la curiosité se promène."
          }
        }
      }
    },
    "theme.discover.closeness.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closeness compounds quietly. One small warmth today — a folded shirt, a favorite mug set out, a hand on a shoulder passing by — outweighs a grand gesture saved for someday."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La proximité compose en silence. Une petite chaleur aujourd'hui — une chemise pliée, une tasse préférée posée, une main sur une épaule au passage — pèse plus qu'un grand geste gardé pour un jour jamais venu."
          }
        }
      }
    },
    "theme.discover.closeness.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Affection without agenda rebuilds trust in touch itself. A hand that wants nothing teaches the skin a new language. Give three no-agenda touches today and receive at least one without returning it like a debt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'affection sans programme reconstruit la confiance dans le contact. Une main qui ne veut rien apprend une langue nouvelle à la peau. Offrez trois contacts sans attente aujourd'hui et recevez-en un sans le rendre comme une dette."
          }
        }
      }
    },
    "theme.discover.closeness.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Distance and closeness take turns in every long story. Neither is failure. Naming which season you are in dissolves half the confusion — and half the loneliness that comes from misreading weather as character."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Distance et proximité se succèdent dans toute longue histoire. Ni l'une ni l'autre n'est un échec. Nommer sa saison dissout la moitié de la confusion — et la moitié de la solitude née de prendre la météo pour du caractère."
          }
        }
      }
    },
    "theme.discover.communication.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Words draw maps. When you can say what you miss — precisely, without blame — the territory between you and what you want becomes navigable. Vague longing stays lost; named longing finds roads."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mots dessinent des cartes. Quand vous pouvez dire ce qui vous manque — précisément, sans reproche — le territoire entre vous et ce que vous voulez devient praticable. L'envie vague reste perdue ; l'envie nommée trouve des routes."
          }
        }
      }
    },
    "theme.discover.communication.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"I miss being looked at\" and \"I miss being taken\" are different countries. Naming which country you live in changes everything you might pack — for you, and for whoever travels with you."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« On me regarde moins » et « je me sens désirable » sont deux pays différents. Savoir dans quel pays vous vivez change tout ce que vous pourriez emporter — pour vous, et pour celui ou celle qui voyage avec vous."
          }
        }
      }
    },
    "theme.discover.communication.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Honesty is a skill, not a confession. One true sentence, spoken without editing for effect, weighs more than a perfectly managed conversation. Today, aim for true rather than impressive."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'honnêteté est une compétence, pas un aveu. Une phrase vraie, dite sans mise en scène, pèse plus qu'une conversation parfaitement gérée. Aujourd'hui, visez vrai plutôt qu'impressionnant."
          }
        }
      }
    },
    "theme.discover.novelty.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Novelty right-sized is a doorway, not a leap. One new lamp, one new playlist, one hour rearranged — attention follows difference like a cat follows movement. Grand gestures startle; small ones beckon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La nouveauté à la bonne dose est une porte, pas un saut. Une lampe nouvelle, une playlist nouvelle, une heure rearrangée — l'attention suit la différence comme un chat suit le mouvement. Les grands gestes effarouchent ; les petits invitent."
          }
        }
      }
    },
    "theme.discover.novelty.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Familiarity hides things in plain sight. The face you know by heart still changes daily. Looking again — slowly, as if for the first time — can make the known feel newly made."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La familiarité cache des choses sous nos yeux. Le visage que vous connaissez par cœur change chaque jour. Regarder encore — lentement, comme pour la première fois — peut rendre le connu tout neuf."
          }
        }
      }
    },
    "theme.discover.novelty.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Difference does not require drama. Rearranging a room, an order, an hour counts. What matters is that your attention wakes up and reports back."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La différence n'exige pas le drame. Réarranger une pièce, un ordre, une heure suffit. L'essentiel est que votre attention se réveille et fasse son rapport."
          }
        }
      }
    },
    "theme.discover.play.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play is seriousness with its shoes off. It is not childish — it is the oldest form of intimacy: two creatures signaling safety through laughter. Curiosity counts even when it ends only in giggles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeu, c'est le sérieux qui a quitté ses chaussures. Ce n'est pas puéril — c'est la plus ancienne forme d'intimité : deux créatures qui annoncent la sécurité par le rire. La curiosité compte même quand elle finit en fou rire."
          }
        }
      }
    },
    "theme.discover.play.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is a specific charge in being caught delighting. Not performing pleasure — being absorbed by it. Witnessed joy is disarming precisely because it cannot be faked."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il y a une charge particulière à être surpris en plein ravissement. Non pas jouer le plaisir — être absorbé par lui. La joie témoignée désarme précisément parce qu'elle ne peut pas se simuler."
          }
        }
      }
    },
    "theme.discover.play.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play lowers the stakes so wanting can breathe. An absurd comment, a ridiculous dance, dessert before dinner — levity is not avoidance when everyone knows the game they are in."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeu abaisse les enjeux pour que l'envie respire. Un commentaire absurde, une danse ridicule, le dessert avant le dîner — la légèreté n'est pas de l'évitement quand chacun connaît le jeu auquel il participe."
          }
        }
      }
    },
    "theme.reflect.anticipation.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What are you quietly looking forward to right now? Let it be specific."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'attendez-vous avec une impatience discrète, en ce moment ? Précisez."
          }
        }
      }
    },
    "theme.reflect.anticipation.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When was the last time the waiting itself felt good?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dernière fois que l'attente elle-même vous a fait du bien, c'était quand ?"
          }
        }
      }
    },
    "theme.reflect.anticipation.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What could you promise tomorrow — softly, with no deadline attached?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que pourriez-vous promettre à demain — doucement, sans échéance ?"
          }
        }
      }
    },
    "theme.reflect.attention.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What did you notice today that you usually walk straight past?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'avez-vous remarqué aujourd'hui d'habitude traversé sans un regard ?"
          }
        }
      }
    },
    "theme.reflect.attention.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where did your attention rest today, even for a breath — and what kept it there?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où votre attention s'est-elle posée aujourd'hui, ne serait-ce qu'un souffle — et qu'est-ce qui l'a retenue ?"
          }
        }
      }
    },
    "theme.reflect.attention.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If your attention had a place of its own today, where would it have been sitting?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si votre attention avait un lieu à elle aujourd'hui, où se serait-elle assise ?"
          }
        }
      }
    },
    "theme.reflect.autonomy.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where did you choose freely today — even in something tiny?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où avez-vous choisi librement aujourd'hui — même dans une broutille ?"
          }
        }
      }
    },
    "theme.reflect.autonomy.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What expectation on you feels heaviest right now? Whose voice is it in?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle attente pèse le plus sur vous en ce moment ? À quelle voix appartient-elle ?"
          }
        }
      }
    },
    "theme.reflect.autonomy.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If nothing were expected of you tonight, what would you reach for first?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si l'on n'attendait rien de vous ce soir, vers quoi iriez-vous d'abord ?"
          }
        }
      }
    },
    "theme.reflect.body.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where in your body is there ease right now? Even a small patch counts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où, dans votre corps, y a-t-il de l'aise en ce moment ? Même une petite zone compte."
          }
        }
      }
    },
    "theme.reflect.body.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What did your body ask for today — and did you hear it before evening?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De quoi votre corps a-t-il eu besoin aujourd'hui — et l'avez-vous entendu avant le soir ?"
          }
        }
      }
    },
    "theme.reflect.body.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which sensation today felt most like you?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle sensation d'aujourd'hui vous a semblé la plus fidèle à vous-même ?"
          }
        }
      }
    },
    "theme.reflect.closeness.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who did you feel closest to today — including future-you or memory?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De qui vous êtes-vous senti·e le plus proche aujourd'hui — y compris vous futur·e ou un souvenir ?"
          }
        }
      }
    },
    "theme.reflect.closeness.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What small warmth reached you this week that nobody planned?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle petite chaleur est arrivée jusqu'à vous cette semaine sans que personne l'ait prévue ?"
          }
        }
      }
    },
    "theme.reflect.closeness.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Is this a season of closeness or distance for you? Name it without judging it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Êtes-vous dans une saison de proximité ou de distance ? Nommez-la sans la juger."
          }
        }
      }
    },
    "theme.reflect.communication.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If one sentence could carry how you feel lately, what would it say?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si une phrase pouvait porter ce que vous ressentez ces temps-ci, laquelle serait-ce ?"
          }
        }
      }
    },
    "theme.reflect.communication.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What do you wish someone would ask you? Ask yourself first."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que souhaiteriez-vous qu'on vous demande ? Posez-vous d'abord la question vous-même."
          }
        }
      }
    },
    "theme.reflect.communication.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What have you been saying with silence lately?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'avez-vous dit récemment par votre silence ?"
          }
        }
      }
    },
    "theme.reflect.novelty.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What was the smallest new thing in your day? Did it change anything after it?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle a été la plus petite chose nouvelle de votre journée ? A-t-elle changé ce qui a suivi ?"
          }
        }
      }
    },
    "theme.reflect.novelty.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What familiar thing did you manage to see as if for the first time?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle chose familière avez-vous réussi à voir comme pour la première fois ?"
          }
        }
      }
    },
    "theme.reflect.novelty.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What would \"new\" look like this week at a dose that doesn't scare you?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À quoi ressemblerait « du nouveau » cette semaine, à une dose qui ne vous effraie pas ?"
          }
        }
      }
    },
    "theme.reflect.play.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When did you last laugh at something no one else saw?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand avez-vous ri pour la dernière fois de quelque chose que personne d'autre n'a vu ?"
          }
        }
      }
    },
    "theme.reflect.play.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What would play look like for you now — not as it was when you were ten?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À quoi ressemblerait le jeu pour vous maintenant — pas comme à dix ans ?"
          }
        }
      }
    },
    "theme.reflect.play.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What's the most unserious thing you secretly enjoy? Defend it in one line."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle est la chose la moins sérieuse dont vous jouissez en secret ? Défendez-la en une ligne."
          }
        }
      }
    },
    "theme.return.anticipation.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Is there anything you're quietly looking forward to now?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Y a-t-il quelque chose que vous attendez déjà, discrètement ?"
          }
        }
      }
    },
    "theme.return.anticipation.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Did the waiting itself feel different today?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'attente elle-même vous a-t-elle paru différente aujourd'hui ?"
          }
        }
      }
    },
    "theme.return.attention.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Did anything warm up under your attention today?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelque chose s'est-il réchauffé sous votre attention aujourd'hui ?"
          }
        }
      }
    },
    "theme.return.attention.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where did noticing take you today?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où la remarque vous a-t-elle mené·e aujourd'hui ?"
          }
        }
      }
    },
    "theme.return.autonomy.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Did choosing freely leave any trace today?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un choix libre vous a-t-il laissé une trace aujourd'hui ?"
          }
        }
      }
    },
    "theme.return.autonomy.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Did saying no (to something small) leave any room behind?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre non (à quelque chose de petit) a-t-il laissé de l'espace derrière lui ?"
          }
        }
      }
    },
    "theme.return.body.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Did your body tell you anything today?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre corps vous a-t-il dit quelque chose aujourd'hui ?"
          }
        }
      }
    },
    "theme.return.body.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Did ease show up anywhere in your body today?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De l'aise est-elle apparue quelque part dans votre corps aujourd'hui ?"
          }
        }
      }
    },
    "theme.return.closeness.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Did any warmth land — given, received, or remembered?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une chaleur est-elle arrivée à bon port — donnée, reçue ou souvenir ?"
          }
        }
      }
    },
    "theme.return.closeness.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can you name which season you're in yet?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrivez-vous à nommer votre saison ?"
          }
        }
      }
    },
    "theme.return.communication.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Was it hard to keep your words honest today? That's information too."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "A-t-il été difficile de garder vos mots honnêtes aujourd'hui ? C'est aussi une information."
          }
        }
      }
    },
    "theme.return.communication.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Did saying (or writing) one true thing cost less than expected?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dire (ou écrire) une chose vraie a-t-il coûté moins cher que prévu ?"
          }
        }
      }
    },
    "theme.return.novelty.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Did the familiar look even slightly new?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le familier vous a-t-il semblé un peu neuf ?"
          }
        }
      }
    },
    "theme.return.novelty.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Did one changed detail change anything after it?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un détail changé a-t-il modifié ce qui suivait ?"
          }
        }
      }
    },
    "theme.return.play.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Did anything make you smile at yourself today?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelque chose vous a-t-il fait sourire de vous aujourd'hui ?"
