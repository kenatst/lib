    "paywall.restore.empty.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No previous purchase was found for this Apple Account. If you believe that's wrong, check you're signed in with the right account and try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun achat précédent n'a été trouvé pour ce compte Apple. Si cela vous semble erroné, vérifiez que vous êtes connecté·e avec le bon compte et réessayez."
          }
        }
      }
    },
    "paywall.restore.empty.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to restore"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à restaurer"
          }
        }
      }
    },
    "paywall.retry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessayer"
          }
        }
      }
    },
    "paywall.subline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first three days are a gift. Beyond them, the full arc adapts to what your evenings tell it — privately, on this device."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les trois premiers jours sont un cadeau. Au-delà, le parcours complet s'adapte à ce que vos soirs lui racontent — en privé, sur cet appareil."
          }
        }
      }
    },
    "paywall.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "EMBER Premium"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "EMBER Premium"
          }
        }
      }
    },
    "paywall.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App Store isn't reachable right now. Your progress is safe — try again in a moment."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'App Store est injoignable pour l'instant. Votre progression est en sécurité — réessayez dans un instant."
          }
        }
      }
    },
    "profile.cta": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shape my journey"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Façonner mon parcours"
          }
        }
      }
    },
    "profile.dim.anticipation.middle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anticipation works on you when given room — a hint is often enough."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'anticipation vous touche quand on lui laisse de la place — un indice suffit souvent."
          }
        }
      }
    },
    "profile.dim.anticipation.opening": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looking forward may matter more than the moment itself right now."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En ce moment, l'attente compte peut-être plus que le moment lui-même."
          }
        }
      }
    },
    "profile.dim.anticipation.rich": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You answer strongly to anticipation; the approach matters as much as the arrival."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous répondez fortement à l'anticipation : l'approche compte autant que l'arrivée."
          }
        }
      }
    },
    "profile.dim.autonomy.middle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You open when nothing is expected of you; autonomy keeps the door unlocked."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous vous ouvrez quand rien n'est attendu ; l'autonomie garde la porte entrouverte."
          }
        }
      }
    },
    "profile.dim.autonomy.opening": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even gentle pressure may switch desire off — room to choose matters."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même une légère pression peut éteindre le désir — pouvoir choisir importe."
          }
        }
      }
    },
    "profile.dim.autonomy.rich": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Freedom is essential to your desire: choice is what makes wanting possible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liberté nourrit votre désir : choisir rend possible le fait de vouloir."
          }
        }
      }
    },
    "profile.dim.communication.middle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One honest exchange does more for you than a week of hints."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul échange sincère vous fait plus qu'une semaine de sous-entendus."
          }
        }
      }
    },
    "profile.dim.communication.opening": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unspoken things may be occupying the room where desire could live."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le non-dit occupe parfois la place où le désir pourrait vivre."
          }
        }
      }
    },
    "profile.dim.communication.rich": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Words unlock you — honest talk is part of your intimacy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mots vous ouvrent — parler vrai fait partie de votre intimité."
          }
        }
      }
    },
    "profile.dim.confidence.middle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For you, confidence grows from small evidence, not big leaps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chez vous, la confiance naît de petites preuves, pas de grands sauts."
          }
        }
      }
    },
    "profile.dim.confidence.opening": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Self-doubt may be standing between you and feeling wanted — gently."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le doute de soi se glisse parfois entre vous et le sentiment d'être désiré·e — doucement."
          }
        }
      }
    },
    "profile.dim.confidence.rich": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You carry a quiet assurance your desire can build on."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous portez une assurance tranquille sur laquelle votre désir peut s'appuyer."
          }
        }
      }
    },
    "profile.dim.connection.middle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Emotional connection reliably warms things for you — conversation, in the truest sense, is intimacy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lien émotionnel vous échauffe sûrement — la conversation, au sens propre, fait partie de l'intimité."
          }
        }
      }
    },
    "profile.dim.connection.opening": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When closeness runs thin, desire finds little to hold onto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand la proximité s'amincit, le désir trouve peu à quoi s'accrocher."
          }
        }
      }
    },
    "profile.dim.connection.rich": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closeness is your engine: when you feel connected, desire follows easily."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La proximité est votre moteur : quand vous vous sentez relié·e, le désir suit."
          }
        }
      }
    },
    "profile.dim.emotionalSafety.middle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Predictable kindness settles you enough to want."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une gentillesse régulière vous apaise assez pour désirer."
          }
        }
      }
    },
    "profile.dim.emotionalSafety.opening": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safety first: your desire waits until tension has somewhere to go."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sécurité d'abord : votre désir attend que la tension trouve une issue."
          }
        }
      }
    },
    "profile.dim.emotionalSafety.rich": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have built real safety, and your desire trusts it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez bâti une vraie sécurité, et votre désir s'y fie."
          }
        }
      }
    },
    "profile.dim.novelty.middle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A touch of newness reawakens attention — small departures beat grand gestures."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une pointe de nouveauté réveille l'attention — petits écarts valent mieux que grands gestes."
          }
        }
      }
    },
    "profile.dim.novelty.opening": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Familiar comfort serves you better than novelty right now."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour l'heure, le familier vous sert mieux que la nouveauté."
          }
        }
      }
    },
    "profile.dim.novelty.rich": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Novelty wakes your desire quickly; sameness is what dims it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La nouveauté éveille vite votre désir ; c'est la répétition qui l'éteint."
          }
        }
      }
    },
    "profile.dim.playfulness.middle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Playfulness lowers your guard faster than deep conversations do."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeu vous désarme plus vite que les grandes conversations."
          }
        }
      }
    },
    "profile.dim.playfulness.opening": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seriousness has been guarding something — play may be the way back in."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sérieux veillait sur quelque chose — le jeu est peut-être le chemin du retour."
          }
        }
      }
    },
    "profile.dim.playfulness.rich": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play is your native language of intimacy; laughter opens everything."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeu est votre langue maternelle intime ; le rire ouvre tout."
          }
        }
      }
    },
    "profile.dim.selfConnection.middle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Small acts of self-attention restore the signal your desire listens for."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De petites attentions à vous-même rétablissent le signal que votre désir écoute."
          }
        }
      }
    },
    "profile.dim.selfConnection.opening": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Desire often starts as noticing yourself again — that attention may be due."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le désir commence souvent par se remarquer soi-même — cette attention vous attend."
          }
        }
      }
    },
    "profile.dim.selfConnection.rich": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are in touch with yourself, and your desire speaks clearly because of it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes à l'écoute de vous-même, et votre désir s'exprime clairement grâce à cela."
          }
        }
      }
    },
    "profile.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Desire isn't a score. It's weather. This simply maps today's climate."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le désir n'est pas une note. C'est une météo. Ceci trace simplement le climat du jour."
          }
        }
      }
    },
    "profile.lede.myDesire": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read this slowly. It describes your desire — no one else's."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisez lentement. Il décrit votre désir — celui de personne d'autre."
          }
        }
      }
    },
    "profile.lede.ourDesire": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two people, one weather system. Here is the climate you described."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux personnes, une même météo. Voici le climat que vous décrivez."
          }
        }
      }
    },
    "profile.lede.theirDesire": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This maps the ground attraction grows on — in you, and around you both."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce portrait trace le terrain où l'attraction repousse — en vous comme entre vous."
          }
        }
      }
    },
    "profile.standout": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What stands out"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui ressort"
          }
        }
      }
    },
    "profile.title": {
      "localizations": {
