    "common.ok": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "couple.asymmetric.day.1.partnerOne": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Think of one small thing they used to do that made you feel chosen. Remember it fully; tell them tonight."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pensez à une petite chose qu'il ou elle faisait et qui vous faisait sentir choisi·e. Rappelez-la, et dites-le leur ce soir."
          }
        }
      }
    },
    "couple.asymmetric.day.1.partnerTwo": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recall the exact moment you knew you liked this person. Tell them one detail of it tonight."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retrouvez l'instant précis où vous avez su que vous aimiez cette personne. Racontez-leur un détail ce soir."
          }
        }
      }
    },
    "couple.asymmetric.day.10.partnerOne": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Message them about something you look forward to doing together. Name it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez un message sur quelque chose que vous attendez de faire ensemble. Nommez-le."
          }
        }
      }
    },
    "couple.asymmetric.day.10.partnerTwo": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell them, plainly, one sound or habit from your early days you'd like back."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites simplement quel son ou quelle habitude des premiers jours vous aimeriez retrouver."
          }
        }
      }
    },
    "couple.asymmetric.day.11.partnerOne": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a song from when you met. Play it tonight and tell them why."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une chanson de vos débuts. Jouez-la ce soir et dites pourquoi."
          }
        }
      }
    },
    "couple.asymmetric.day.11.partnerTwo": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Light a candle at dinner and tell them it's for the two of you."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allumez une bougie au dîner et dites que c'est pour vous deux."
          }
        }
      }
    },
    "couple.asymmetric.day.12.partnerOne": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave one small note somewhere they'll find tomorrow. Sign it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déposez un petit mot où il le trouvera demain. Signez-le."
          }
        }
      }
    },
    "couple.asymmetric.day.12.partnerTwo": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warm their side of the bed before they get in, and wish them a soft night."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réchauffez son côté du lit avant qu'il ou elle n'y entre, et souhaitez une douce nuit."
          }
        }
      }
    },
    "couple.asymmetric.day.13.partnerOne": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask them one question tonight you've never asked. Listen without replying about yourself."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez ce soir une question jamais posée. Écoutez sans répondre en parlant de vous."
          }
        }
      }
    },
    "couple.asymmetric.day.13.partnerTwo": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell them one thing you noticed them doing well this week. Keep it under one sentence."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites une chose que vous l'avez vu·e bien faire cette semaine. Une phrase maximum."
          }
        }
      }
    },
    "couple.asymmetric.day.14.partnerOne": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell them one small plan you have for tomorrow that involves them. Let them ask questions."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annoncez un petit plan pour demain qui les inclut. Laissez-les poser des questions."
          }
        }
      }
    },
    "couple.asymmetric.day.14.partnerTwo": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch their hand today and leave it there three seconds longer than habit — and smile."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez sa main aujourd'hui trois secondes de plus que d'habitude — et souriez."
          }
        }
      }
    },
    "couple.asymmetric.day.15.partnerOne": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Think of one small thing they used to do that made you feel chosen. Remember it fully; tell them tonight."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pensez à une petite chose qu'il ou elle faisait et qui vous faisait sentir choisi·e. Rappelez-la, et dites-le leur ce soir."
          }
        }
      }
    },
    "couple.asymmetric.day.15.partnerTwo": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recall the exact moment you knew you liked this person. Tell them one detail of it tonight."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retrouvez l'instant précis où vous avez su que vous aimiez cette personne. Racontez-leur un détail ce soir."
          }
        }
      }
    },
    "couple.asymmetric.day.16.partnerOne": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tonight, make them a drink the way they like it, and say it's because you felt like it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce soir, préparez-lui à boire comme il aime — et dites que c'est par envie."
          }
        }
      }
    },
    "couple.asymmetric.day.16.partnerTwo": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tonight, suggest dinner with no screens at the table — and say why you want it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce soir, proposez un dîner sans écrans — et dites pourquoi vous en avez envie."
          }
        }
      }
    },
    "couple.asymmetric.day.17.partnerOne": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Message them about something you look forward to doing together. Name it."
          }
        },
