{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "a11y.sketch.hero": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hand-drawn sketch of two organic forms approaching each other"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Croquis dessiné à la main de deux formes organiques qui s'approchent"
          }
        }
      }
    },
    "agegate.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a space for grown conversations about intimacy. Please confirm you are 18 or older."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet espace accueille des conversations adultes sur l'intimité. Merci de confirmer que vous avez 18 ans ou plus."
          }
        }
      }
    },
    "agegate.confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I am 18 or older"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai 18 ans ou plus"
          }
        }
      }
    },
    "agegate.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "EMBER speaks about desire — with adults."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "EMBER parle de désir — avec des adultes."
          }
        }
      }
    },
