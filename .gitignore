# macOS
.DS_Store
.AppleDouble
.LSOverride

# Xcode user state (machine-local, never shared)
xcuserdata/
*.xcuserstate
*.xcscmblueprint

# Build artifacts
build/
DerivedData/
*.ipa
*.dSYM.zip
*.dSYM
*.xctestrun

# Test results
