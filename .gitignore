.build/
Package.resolved
Package.pins

# CocoaPods / Carthage are not used in this project
Pods/
Carthage/

# Secrets & local environment — never commit credentials or API keys
.env
.env.*
*.entitlements.local
secrets/
*.pem
*.p12
*.mobileprovision

# Playgrounds / scratch files
*.playground
